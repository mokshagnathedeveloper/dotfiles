{
    "layer": "top",
    "position": "top",
    "height": 30, 
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    "spacing": 0,

    "modules-left": ["network", "bluetooth", "pulseaudio", "custom/mpv-music"],
    "modules-center": ["group/workspace-pill", "hyprland/window"],
    "modules-right": ["cpu", "memory", "custom/notification", "tray", "backlight", "battery", "clock"],

    "group/workspace-pill": {
        "orientation": "horizontal",
        "modules": ["custom/ws-icon", "hyprland/workspaces"]
    },

    "custom/ws-icon": {
        "format": "",
        "on-click": "hyprctl dispatch togglespecialworkspace"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": true,
        "on-click": "activate"
    },

     "hyprland/window": {
        "format": "󰖲 {class}",
        "max-length": 20,
        "separate-outputs": true,
        "rewrite": {
            "^.*zen.*$": "󰚀 Zen",
	    "^.*mpv.*$": "󰕧 MPV",
            "^.*heroic.*$": "󰓥 Heroic",
	    "^.*steam.*$": "󰓓 Steam",
            "^.*kitty.*$": "󰄛 Kitty",
	    "^.*kitty-btop.*$": "󰓅 Btop",
            "^.*kitty-cava.*$": "󰝚 Cava",
            "^$": "󰖲 Desktop"
        }
     },

     "cpu": {
        "interval": 2,
        "format": "  {usage}%",
        "tooltip": true,
        "on-click": "kitty --class kitty-btop -e btop"
    },

    "memory": {
        "interval": 3,
        "format": "  {used:0.1f}G",
        "tooltip-format": "RAM: {used}GB / {total}GB\nSwap: {swapUsed}GB / {swapTotal}GB",
        "on-click": "kitty --class kitty-btop -e btop"
    },

"network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "󰖪  Disconnected",
    "format-disabled": "󰖪  Disabled", 
    "on-click": "kitty --class floating_wifi -e nmtui",
    "on-click-right": "nmcli radio wifi | grep -q 'enabled' && nmcli radio wifi off || nmcli radio wifi on",
    "tooltip-format": "{essid}:{signalStrength}%"
},

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": { "default": ["", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "bluetooth": {
	    "format": " {status}",
	    "format-enabled": " On",
        "format-connected": " {num_connections}",
        "format-disabled": "󰂲 Off",
        "on-click": "blueman-manager",
        "on-click-right": "rfkill toggle bluetooth"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %d %b %Y}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

"custom/mpv-music": {
        "format": "{icon} {text}",
        "return-type": "json",
	"max-length": 20,
        "exec": "playerctl --player=mpv metadata --format '{\"text\": \"{{title}} - {{artist}}\", \"alt\": \"{{status}}\", \"tooltip\": \"{{title}} by {{artist}}\"}' 2>/dev/null",              "exec-if": "pgrep mpv",
        "interval": 2,
        "format-icons": {
            "Playing": "<span foreground='#DBC58F'>󰎆</span>",
            "Paused": "󱋤"
        },
        "on-click": "playerctl --player=mpv play-pause",
        "on-click-right": "playerctl --player=mpv next",
        "on-scroll-up": "playerctl --player=mpv volume 0.05+",
        "on-scroll-down": "playerctl --player=mpv volume 0.05-"
    }
}
