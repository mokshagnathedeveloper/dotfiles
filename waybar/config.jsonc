{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "network", "bluetooth", "pulseaudio", "mpris"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray", "cpu", "memory", "backlight", "battery", "clock"],

    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": true,
        "on-click": "activate",
        "show-special": true,
        "format-window-separator": "\n",
        "window-rewrite-default": "• {class}",
        "window-rewrite": {
            "class<.*zen.*>": "󰚀 Zen",
            "class<.*mpv.*>": "󰕧 MPV",
            "class<.*heroic.*>": "󰓥 Heroic",
            "class<.*steam.*>": "󰓓 Steam",
            "class<.*kitty.*>": "󰄛 Kitty"
        }
    },

    "hyprland/window": {
        "format": "󰖲 {class}",
        "max-length": 20,
        "separate-outputs": true,
        "rewrite": {
            "^.*zen.*$": "󰚀 Zen",
            "^.*mpv.*$": "󰕧 MPV",
            "^.*heroic.*$": "󰓥 Heroic",
            "^.*steam.*$": "󰓓 Steam",
            "^.*kitty.*$": "󰄛 Kitty",
            "^.*kitty-btop.*$": "󰓅 Btop",
            "^.*kitty-cava.*$": "󰝚 Cava",
            "^$": "󰖲 Desktop"
        }
    },

    "cpu": {
        "interval": 2,
        "format": "  {usage}%",
        "tooltip": true,
        "on-click": "kitty --class kitty-btop -e btop"
    },

    "memory": {
        "interval": 3,
        "format": "  {used:0.1f}G",
        "tooltip-format": "RAM: {used}GB / {total}GB\nSwap: {swapUsed}GB / {swapTotal}GB",
        "on-click": "kitty --class kitty-btop -e btop"
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪  Disconnected",
        "format-disabled": "󰖪  Disabled",
        "on-click": "kitty --class floating_wifi -e nmtui",
        "on-click-right": "nmcli radio wifi | grep -q 'enabled' && nmcli radio wifi off || nmcli radio wifi on",
        "tooltip-format": "{essid}:{signalStrength}%"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": { "default": ["", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "bluetooth": {
        "format": " {status}",
        "format-enabled": " On",
        "format-connected": " {num_connections}",
        "format-disabled": "󰂲 Off",
        "tooltip": true,
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "blueman-manager",
        "on-click-right": "rfkill toggle bluetooth"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %d %b %Y}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "mpris": {
        "format": "{player_icon} {title} - {artist}",
        "format-paused": "{status_icon} {title} - {artist}",
        "max-length": 20,
        "player-icons": {
            "default": "<span foreground='#00FFFF'>󰎆</span>"
        },
        "status-icons": {
            "paused": "▶︎"
        }
    }
}
