{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/Rose.txt",
        "type": "file",
        "color": {
            "1": "#FFB7C5"
        },
        "padding": {
            "top": 1,
            "right": 4
        }
    },
    "display": {
        "color": "#00FFFF",
        "separator": " 󰄾 "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "wm",
        "terminal",
        {
            "type": "cpu",
	    "format": "{1}"
        },
        {
            "type": "gpu",
	    "format": "{2}"
        },
        "memory",
        "disk"
    ]
}
