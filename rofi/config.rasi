
configuration {
    modi: "drun,run";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: false;
    display-drun: "Search"; 
    
    /* --- ADD THESE THREE LINES --- */
    drun-match-fields: "name";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
}
window {
    width: 600px;
    height: 400px;
    border: 2px;
    border-color: #284EC3;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.60);
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    margin: 10px;
    padding: 8px;
    children: [ prompt, entry ];
    background-color: transparent;
}

prompt {
    background-color: transparent;
    text-color: #DBC58F;
    padding: 0px 10px 0px 0px;
}

textbox-prompt-colon {
    enabled: false;
}

entry {
    background-color: transparent;
    text-color: #B9DAF8;
}

listview {
    margin: 5px 10px 10px 10px;
    lines: 8;
    background-color: transparent;
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 8px;
    border-radius: 8px;
    background-color: transparent;
}

element normal.normal,
element alternate.normal,
element normal.urgent,
element alternate.urgent,
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: #B9DAF8;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color: transparent;
    border: 2px;
    border-color: #DBC58F;
    text-color: #DBC58F;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element-icon {
    size: 24px;
    background-color: transparent;
}
